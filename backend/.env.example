# TalentSync AI — contoh konfigurasi aplikasi backend.
# Salin file ini menjadi backend/.env lalu sesuaikan.
# File backend/.env TIDAK di-commit; ia adalah satu-sumber konfigurasi untuk
# uvicorn, alembic, scripts, dan pytest lokal — dibaca dari working directory
# mana pun (path di-anchor ke direktori backend/, lihat ADR 0005).

# === Database (Supabase PostgreSQL / session pooler) ===
# Format: postgresql+psycopg://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres?sslmode=require
# - Port 5432 = session pooler (didukung prepared statements — pilihan utama).
# - Port 6543 = transaction pooler (cadangan).
# - Password database yang mengandung karakter khusus HARUS ter-URL-encode
#   (contoh: # menjadi %23).
DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# === Backend ===
APP_ENV=dev
LOG_LEVEL=INFO
# Daftar origin frontend yang diizinkan (dipisah koma atau JSON array)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# P1 (JWT): kunci signing. WAJIB diisi dengan nilai acak >= 32 karakter di
# lingkungan selain lokal. Jangan pernah mengisi nilai asli di file yang di-commit.
SECRET_KEY=

# === P3 — AI Engine ===
# LLM via Groq (dipakai Modul 8 CV Optimization). Kosongkan GROQ_API_KEY untuk
# menonaktifkan fitur LLM (semua test memakai mock).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MODEL_FALLBACK=openai/gpt-oss-20b

# Embedding multilingual (384 dim). Model final dibekukan setelah benchmark
# e5-small vs MiniLM pada golden set sintetis — lihat docs/04 & ADR 0006.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384

# Bobot skor kompatibilitas: semantic, skill, experience, education (total = 1.0)
MATCH_WEIGHTS=0.40,0.30,0.20,0.10
