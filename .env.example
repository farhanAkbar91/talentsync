# TalentSync AI — contoh environment untuk DOCKER COMPOSE (root).
# File ini hanya berisi variabel substitusi docker-compose.yml (service db lokal
# dan nilai default api). JANGAN commit file .env yang berisi nilai asli.
#
# Konfigurasi APLIKASI backend (DATABASE_URL Supabase, SECRET_KEY, GROQ_*, dll.)
# ada di backend/.env — template: backend/.env.example. Compose api memuatnya
# via env_file, lalu menimpa DATABASE_URL agar menunjuk ke service `db` lokal.

# === Database lokal Docker Compose (pgvector/pg16, hanya dev offline) ===
POSTGRES_USER=talentsync
POSTGRES_PASSWORD=talentsync_dev_only
POSTGRES_DB=talentsync

# === Nilai default service api pada mode Docker ===
APP_ENV=dev
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
