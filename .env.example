# TalentSync AI — contoh konfigurasi environment.
# Salin file ini menjadi `.env` lalu sesuaikan. JANGAN commit file .env yang berisi nilai asli.

# === Database (dipakai Docker Compose & backend) ===
POSTGRES_USER=talentsync
POSTGRES_PASSWORD=talentsync_dev_only
POSTGRES_DB=talentsync

# URL koneksi backend (driver psycopg v3).
# Di dalam Docker Compose nilai ini di-set otomatis menunjuk ke service `db`.
DATABASE_URL=postgresql+psycopg://talentsync:talentsync_dev_only@localhost:5432/talentsync

# === Backend ===
APP_ENV=dev
LOG_LEVEL=INFO
# Daftar origin frontend yang diizinkan (dipisah koma)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# P1 (JWT): kunci signing. WAJIB diisi dengan nilai acak >= 32 karakter di lingkungan
# selain lokal. Jangan pernah mengisi nilai asli di file yang di-commit.
SECRET_KEY=

# === Frontend (opsional) ===
# Default sudah tepat untuk dev (Vite proxy) dan production (nginx proxy).
# VITE_API_BASE_URL=/api/v1
